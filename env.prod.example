# Copy to env.prod and fill in secrets. env.prod is gitignored.
# Dump/restore over SSH: npm run db:dump  /  npm run db:restore -- path/to.db
# App updates on the VPS: /opt/moneyflow/install.sh update

DEPLOY_HOST=your.server.ip
DEPLOY_USER=deploy
DEPLOY_PATH=/opt/moneyflow
DEPLOY_SSH_KEY=.deploy-keys/moneyflow_deploy
DEPLOY_SSH_PORT=22

WEB_ORIGIN=https://your.domain
ACCESS_KEY=change-me-access-key
SESSION_SECRET=change-me-session-secret
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=
VITE_TELEGRAM_BOT_ID=
TELEGRAM_BOT_ID=
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=openai/gpt-4o
